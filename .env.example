# Copy to `.env` (docker compose reads it automatically) and fill in as needed.
# Every value here is OPTIONAL — the service boots and serves with none of them.

# --- Auth (optional) -------------------------------------------------------
# If set, every endpoint except /health requires `Authorization: Bearer <token>`.
# If unset/empty, auth is disabled and any/no token is accepted.
MEMORY_AUTH_TOKEN=

# --- Extraction LLM (optional, recommended) --------------------------------
# When ANTHROPIC_API_KEY is present the service extracts structured memories
# with Claude. Without it, it falls back to a deterministic rule-based
# extractor (lower recall, no network needed).
ANTHROPIC_API_KEY=
# Only set if you proxy the Anthropic API; defaults to the public endpoint.
ANTHROPIC_BASE_URL=
# Model used for extraction. Default is claude-opus-4-8 (highest quality).
# claude-haiku-4-5-20251001 is a strong lower-latency / lower-cost alternative.
EXTRACTION_MODEL=claude-opus-4-8
# auto = LLM when a key is present else rules. Force with: llm | rules
EXTRACTION_BACKEND=auto

# --- Embeddings (optional) -------------------------------------------------
# local  = dependency-free hashed n-gram vectorizer (default; no network, no key)
# openai = text-embedding-3-small (needs OPENAI_API_KEY)
# voyage = voyage-3 (needs VOYAGE_API_KEY)
# NOTE: the embedder is a deploy-time choice. Changing it after data exists
# makes stored vectors incomparable — reset the volume if you switch.
EMBED_PROVIDER=local
EMBED_DIM=384
OPENAI_API_KEY=
VOYAGE_API_KEY=

# --- Backing store ---------------------------------------------------------
# Set automatically by docker-compose; override only for local runs.
# DATABASE_URL=postgresql://memory:memory@localhost:5432/memory
